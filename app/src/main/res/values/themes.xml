<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CKFit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ckfit_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.CKFit.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ckfit_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CKFit</item>
    </style>
</resources>
