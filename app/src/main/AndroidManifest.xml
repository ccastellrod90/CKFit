<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Entrenamiento en curso: servicio en primer plano con la pantalla apagada. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Comandos de voz (Vosk, sin conexión): se pide al primer entrenamiento; sin él, todo funciona con botones. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 13+: se pide al abrir el primer ejercicio; sin él la app funciona igual. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Ajustes → Batería: pedir que no se optimice la app (entrenamientos con la pantalla apagada). -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Solo para "Tomar del teléfono" (nombre de la tarjeta «Yo»); se pide al tocar el botón. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Android 11+: para poder usar el motor de texto a voz instalado y ofrecer instalar la voz en español. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".CKFitApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CKFit.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CKFit.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- mediaPlayback siempre (avisos hablados); microphone se añade en tiempo de ejecución solo con permiso. -->
        <service
            android:name=".service.WorkoutService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone" />
    </application>

</manifest>
